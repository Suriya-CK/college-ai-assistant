# ==========================================
# College AI Voice Assistant Configuration
# ==========================================

# LLM Providers (Provide at least one, or enter via the Web UI Settings)
GEMINI_API_KEY=
OPENAI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=

# Default LLM Provider: "gemini", "groq", "openai" or "openrouter"
DEFAULT_LLM_PROVIDER=groq

# Default Model Names
GEMINI_MODEL=gemini-3.8-flash
OPENAI_MODEL=gpt-4o-mini
GROQ_MODEL=openai/gpt-oss-120b
OPENROUTER_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free

# Speech-to-text with language detection (Groq Whisper)
WHISPER_MODEL=whisper-large-v3

# Crawler settings
DEFAULT_MAX_PAGES=120
DEFAULT_MAX_DEPTH=4
CRAWL_CONCURRENCY=2
CRAWL_DELAY=1.0
EXTRACT_FACTS=1
EXTRACT_MAX_PAGES=40
EXTRACT_TOKENS_PER_MIN=0
QUICK_TEST=0
REQUEST_TIMEOUT=15
USER_AGENT=CollegeAssistantBot/1.0 (+https://github.com/college-assistant)

# Storage
DATABASE_PATH=data/college_knowledge.db
AUDIO_CACHE_DIR=data/audio_cache

# Server
HOST=127.0.0.1
PORT=8000
