# ==========================================
# College AI Voice Assistant Configuration
# ==========================================

# LLM Providers (Provide at least one, or enter via the Web UI Settings)
GEMINI_API_KEY=
OPENAI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=
# Cerebras: very fast inference (cloud.cerebras.ai). Set DEFAULT_LLM_PROVIDER=cerebras to use it
CEREBRAS_API_KEY=

# Default LLM Provider: "gemini", "groq", "openai" or "openrouter"
DEFAULT_LLM_PROVIDER=groq

# Default Model Names
GEMINI_MODEL=gemini-3.8-flash
OPENAI_MODEL=gpt-4o-mini
GROQ_MODEL=openai/gpt-oss-20b
# Model for fact extraction after a crawl (its own rate limit, so chat stays fast during a crawl)
GROQ_EXTRACT_MODEL=openai/gpt-oss-120b
# How long gpt-oss models think before answering a chat question: low, medium or high
GROQ_REASONING_EFFORT=low
# Cerebras model names have no "openai/" prefix: gpt-oss-120b or qwen-3.8-27b
CEREBRAS_MODEL=gpt-oss-120b
CEREBRAS_EXTRACT_MODEL=gpt-oss-120b
CEREBRAS_REASONING_EFFORT=low
OPENROUTER_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free

# Speech-to-text with language detection (Groq Whisper)
WHISPER_MODEL=whisper-large-v3

# Crawler settings
DEFAULT_MAX_PAGES=120
DEFAULT_MAX_DEPTH=4
CRAWL_CONCURRENCY=2
CRAWL_DELAY=1.0
EXTRACT_FACTS=1
EXTRACT_MAX_PAGES=40
EXTRACT_TOKENS_PER_MIN=0
QUICK_TEST=0
REQUEST_TIMEOUT=15
# Leave unset to use a normal browser user agent (many college sites refuse anything that calls itself a bot)
# USER_AGENT=

# Storage
DATABASE_PATH=data/college_knowledge.db
AUDIO_CACHE_DIR=data/audio_cache

# Server
HOST=127.0.0.1
PORT=8000
